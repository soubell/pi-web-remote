{
	email {$ACME_EMAIL}
	admin off
}

# 例: mypi.duckdns.org
{$DUCKDNS_DOMAIN} {
	# DuckDNS の API で TXT を書き換える DNS-01。ポート80を開けずに済む
	tls {
		dns duckdns {$DUCKDNS_API_TOKEN}
		propagation_delay 30s
	}

	log {
		output file /data/access.log {
			roll_size 10MiB
			roll_keep 5
		}
		format console
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		-Server
	}

	# OAuth のコールバックは oauth2-proxy に直接流す（認証対象外）
	handle /oauth2/* {
		reverse_proxy oauth2-proxy:4180
	}

	# それ以外は GitHub ログイン必須 → そのまま Pi Web へ
	handle {
		forward_auth oauth2-proxy:4180 {
			uri /oauth2/auth
			copy_headers X-Auth-Request-User X-Auth-Request-Email
		}

		# SSE（ストリーミング応答）をバッファリングしない
		reverse_proxy {$PI_WEB_UPSTREAM} {
			flush_interval -1
			transport http {
				read_timeout 1h
				write_timeout 1h
			}
		}
	}
}
