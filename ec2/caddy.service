[Unit]
Description=Caddy (Pi Web front proxy / TLS / Basic auth)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
# DNS レコードが現在の IP を向いてから起動する（TLS-ALPN-01 の検証が通るように）
Wants=pi-web-duckdns.service
After=pi-web-duckdns.service

[Service]
Type=oneshot
RemainAfterExit=yes
# @REPO_DIR@ は install.sh が実際のパスに置換する
WorkingDirectory=@REPO_DIR@
# 自前ビルドのイメージ（pi-web-caddy:local）なので pull ではなく build
ExecStartPre=/usr/bin/docker compose build --quiet
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
