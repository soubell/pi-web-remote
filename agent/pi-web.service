[Unit]
Description=Pi Web (pi coding agent web UI)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 秘密情報は EnvironmentFile に置く（chmod 600）。中身は KEY=VALUE 形式:
#   PI_WEB_PASSWORD=.....
#   PI_WEB_ALLOWED_HOSTS=mypi.duckdns.org
#   PI_WEB_IDLE_TIMEOUT_MS=0
#   PI_WEB_NO_OPEN=1
EnvironmentFile=%h/.config/pi-web/env
ExecStart=/usr/bin/npx --yes @agegr/pi-web@latest -H 127.0.0.1 -p 30141 --no-open
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
