# ============================================================================
# Pi Web on EC2 — 設定はこの 1 ファイルだけ。あとは `sudo ./install.sh` が配る。
#
#   ec2/.env  ->  duckdns/.env.caddy                (Caddy 用)
#             ->  /etc/pi-web/duckdns.env           (DuckDNS 更新用)
#             ->  /home/piweb/.config/pi-web/env    (Pi Web 用)
#
# 使う前にコピーして値を入れる:  cp .env.example .env
#
# ※ ここに書けるキーは決まっている（許可リスト方式）。未知のキーは警告を出して無視される。
#    PATH などを書いても反映されない。
# ============================================================================

# --- DuckDNS ---------------------------------------------------------------
DUCKDNS_DOMAIN=mypi.duckdns.org
DUCKDNS_TOKEN=

# Let's Encrypt の登録メール。空なら acme@<DUCKDNS_DOMAIN> が使われる
ACME_EMAIL=

# --- Basic 認証（Caddy 側。Pi Web のパスワードとは別の値にする） ------------
# パスワードは平文でここに書き、install.sh が bcrypt ハッシュに変換して配る
BASIC_AUTH_USER=pi
BASIC_AUTH_PASSWORD=

# --- Pi Web ---------------------------------------------------------------
# 32 文字以上のランダム推奨: openssl rand -base64 32
PI_WEB_PASSWORD=
# 0 でアイドル自動終了を無効化（既定 10 分）
PI_WEB_IDLE_TIMEOUT_MS=0
# Caddy から Pi Web への転送先（通常は変更不要）
PI_WEB_UPSTREAM=127.0.0.1:30141

# --- モデルプロバイダ（任意） ----------------------------------------------
# ここに書いた API キーは /home/piweb/.config/pi-web/env にコピーされ、
# Pi Web（pi 本体）が環境変数として読む。未設定なら起動後に Web UI の
# 「Models」パネルからログイン / キー入力すればよい（~/.pi/agent/auth.json に保存）。
# 代表例:
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# DEEPSEEK_API_KEY=
# XAI_API_KEY=

# 既存の pi データ（~/.pi/agent など）を共有したい場合だけ指定
# PI_CODING_AGENT_DIR=

# --- 反映方法 ---------------------------------------------------------------
#   sudo ./install.sh                     標準（EC2 + ネイティブ Caddy）
#   sudo ./install.sh --with-docker-caddy Docker 版 Caddy も更新する（非標準）
#   ./install.sh --dry-run                書き込み内容のプレビュー
