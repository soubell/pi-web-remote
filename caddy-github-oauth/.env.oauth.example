# === oauth2-proxy 用（setup.sh が .env.oauth として生成する。このファイルは雛形） ===
# GitHub OAuth App は https://github.com/settings/developers で作成
#   Homepage URL            : https://mypi.duckdns.org
#   Authorization callback  : https://mypi.duckdns.org/oauth2/callback
OAUTH2_PROXY_PROVIDER=github
OAUTH2_PROXY_CLIENT_ID=
OAUTH2_PROXY_CLIENT_SECRET=

# cookie 署名鍵（16/24/32 バイトを base64）。setup.sh が自動生成する
OAUTH2_PROXY_COOKIE_SECRET=
OAUTH2_PROXY_COOKIE_SECURE=true
OAUTH2_PROXY_COOKIE_SAMESITE=lax
OAUTH2_PROXY_COOKIE_EXPIRE=24h

# Caddy が前段（TLS 終端）なので必須
OAUTH2_PROXY_REVERSE_PROXY=true
OAUTH2_PROXY_REDIRECT_URL=https://mypi.duckdns.org/oauth2/callback

# 認証のみ担当（振り分けは Caddy の forward_auth が行う）
OAUTH2_PROXY_UPSTREAMS=static://202
OAUTH2_PROXY_SET_XAUTHREQUEST=true

# メールは取れないので必須。* で「ドメイン制限なし」
OAUTH2_PROXY_EMAIL_DOMAINS=*

# ★ここが実質のアクセス制御。GitHub のログイン名で絞る（カンマ区切りで複数可）
#   org / team で縛る場合は OAUTH2_PROXY_GITHUB_ORG / _TEAM を使う
OAUTH2_PROXY_GITHUB_USER=
