[Unit]
Description=Caddy (Pi Web front proxy / TLS / Basic auth)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
# DNS レコードが現在の IP を向いてから起動する（TLS-ALPN-01 の検証が通るように）
Wants=pi-web-duckdns.service
After=pi-web-duckdns.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/ubuntu/pi-web-remote/duckdns
ExecStartPre=/usr/bin/docker compose pull --quiet
ExecStart=/usr/bin/docker compose up -d --build
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
