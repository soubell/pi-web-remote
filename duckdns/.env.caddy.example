# === Caddy 用（setup.sh が .env.caddy として生成する。このファイルは雛形） ===
DUCKDNS_DOMAIN=mypi.duckdns.org
DUCKDNS_API_TOKEN=

ACME_EMAIL=you@example.com

# Basic 認証（第2層）。ハッシュは setup.sh が bcrypt で生成する
BASIC_AUTH_USER=pi
BASIC_AUTH_HASH=$2a$14$...........................................

# ホスト側で動く Pi Web
PI_WEB_UPSTREAM=127.0.0.1:30141
